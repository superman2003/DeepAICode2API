# DeepAICode2API 注册链路配置（复制为 .env 后填写）
#
# 邮箱后端优先级：cf -> qqimap -> tempmail_lol -> static -> none
#   cf     : CF Temp Email Worker（可自动收信并点邮箱验证链接）
#   qqimap : 域名随机地址转发到 QQ 邮箱，通过 IMAP 自动收信验证
#   tempmail_lol : 外部 TempMail.lol 自动创建邮箱并收信
#   static : 固定域名随机前缀（无收件箱，跳过邮箱验证）
#   none   : 使用 -email 指定的固定邮箱（无收件箱）

# ── CF Temp Email Worker（免费，推荐）──────────────────────────────
TEMPMAIL_BASE=
TEMPMAIL_ADMIN_KEY=
TEMPMAIL_DOMAIN=

# ── 外部 TempMail.lol ─────────────────────────────────────────────
# API Key 可选，留空使用免费层；付费密钥只发送到此 API。
TEMPMAIL_LOL_BASE=https://api.tempmail.lol/v2
TEMPMAIL_LOL_API_KEY=
# 收信令牌的私有目录；网关默认存于状态文件旁的 exports 中。
TEMPMAIL_LOL_TOKEN_DIR=

# ── 域名邮箱 + QQ IMAP ────────────────────────────────────────────
# 将域名的 Catch-all 邮件转发到 QQ_IMAP_USER；QQ 邮箱需开启 IMAP。
# 使用 QQ 邮箱生成的 IMAP 授权码，不是 QQ 登录密码。也可在注册页面填写。
QQ_IMAP_HOST=imap.qq.com
QQ_IMAP_PORT=993
QQ_IMAP_USER=
QQ_IMAP_AUTH_CODE=
QQ_IMAP_FOLDER=INBOX

# ── 静态域名（无收件箱）────────────────────────────────────────────
# 例如 example.com；会生成 dai<随机>@<域名>
DEEPAI_REGISTER_DOMAIN=

# ── 注册链路行为 ──────────────────────────────────────────────────
# 强制邮箱后端：cf / qqimap / tempmail_lol / static / none（留空自动选择）
DEEPAI_REGISTER_MAIL_BACKEND=
# 控制台单批注册上限，默认 1000；最大支持 10000，并发仍独立受限。
DEEPAI2API_REGISTER_MAX_COUNT=1000
DEEPAI_REGISTER_LANGUAGE=en
DEEPAI_REGISTER_GROUP=default
DEEPAI_REGISTER_PREFIX=dai
DEEPAI_REGISTER_PROBE_MODEL=glm-5.3-flash

# ── 2API 网关 ─────────────────────────────────────────────────────
DEEPAI2API_GATEWAY=http://127.0.0.1:10087
DEEPAI2API_ADMIN_PASSWORD=

# ── 容器 / 无 SMBIOS 环境必填 ─────────────────────────────────────
# 上游所有模型请求都要求 X-DeepAI-Code-Machine；填桌面端所在机器的原始 UUID。
DEEPAI_MACHINE_ID=

# ── 代理池（注册与推理共用）────────────────────────────────────────
# 完整 URL，逗号或换行分隔；每个账号轮询分配一个
PROXY_POOL=
# 或从文件读取（每行一个）
PROXY_POOL_FILE=
# 单个代理（覆盖代理池）
DEEPAI_REGISTER_PROXY=

# 远程代理自身需要经过本机代理才能连接时设置；保留远程代理的出口 IP。
# 链路：注册/推理 -> 本机出口代理 -> 远程代理 -> DeepAI。
# 例如：http://127.0.0.1:7890。支持 HTTP/HTTPS CONNECT，留空则直接连接远程代理。
DEEPAI2API_EGRESS_PROXY=

# 美国服务器可选：代理连接失败时回退本机直连，默认关闭。
# 只在请求尚未发往上游时切换；不会重放结果不明的 POST 请求。
DEEPAI2API_PROXY_FALLBACK_DIRECT=
# Windows 守护脚本可选健康检查：连续约一分钟无法探活时重启进程。
DEEPAI2API_WATCHDOG=

# ── 安全默认值 ────────────────────────────────────────────────────
# 监听非回环地址（0.0.0.0 / 局域网 IP）时必须设置 DEEPAI2API_ADMIN_PASSWORD，
# 否则进程拒绝启动。确实要无密码运行才置 1（会把控制台暴露给整个网段）。
DEEPAI2API_ALLOW_INSECURE=

# ── 状态文件加密（P0-1）───────────────────────────────────────────
# 32 字节密钥，hex 或 base64；留空则状态文件以明文 JSON 落盘（会打警告）。
# 生成：openssl rand -hex 32
DEEPAI2API_MASTER_KEY=
